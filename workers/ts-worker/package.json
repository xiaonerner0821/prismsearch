{
  "name": "@prismsearch/ts-worker",
  "version": "0.3.1",
  "private": true,
  "description": "PrismSearch 抓取 Worker（Node + Playwright），实现 docs/worker-protocol.md 定义的 HTTP+JSON 协议",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "prismsearch-ts-worker": "dist/server.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "node --watch --experimental-strip-types src/server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "turndown": "^7.2.1",
    "undici": "^8.12.3"
  },
  "optionalDependencies": {
    "playwright": "^1.64.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/turndown": "^5.0.5",
    "typescript": "^6.0.3",
    "vitest": "^4.0.0"
  },
  "license": "Apache-2.0"
}
