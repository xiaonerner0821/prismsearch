# 统一换行：文本文件在仓库中一律存为 LF
* text=auto eol=lf

# Windows 脚本需要 CRLF
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# 二进制文件：不做换行转换、不做文本 diff
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.db binary
*.sqlite binary
*.sqlite3 binary
*.woff binary
*.woff2 binary
*.ttf binary
*.zip binary
*.gz binary
*.tgz binary
