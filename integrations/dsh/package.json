{
  "name": "dsh-plugin-prismsearch",
  "version": "0.3.2",
  "description": "DeepSeek Harness bundle for PrismSearch: multi-engine web, image & WeChat search plus page/PDF fetching over MCP, no API key required.",
  "license": "Apache-2.0",
  "type": "module",
  "icon": "./icon.svg",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "mcp",
    "web-search",
    "agent-skill",
    "prismsearch"
  ],
  "author": "xiaonerner0821 <xiaonerner0821@gmail.com> (https://github.com/xiaonerner0821)",
  "homepage": "https://github.com/xiaonerner0821/prismsearch/tree/main/integrations/dsh#readme",
  "bugs": "https://github.com/xiaonerner0821/prismsearch/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaonerner0821/prismsearch.git",
    "directory": "integrations/dsh"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.1-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-mcp-client": ">=0.2.1-rc.2 <0.3.0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
