# EditorConfig —— 统一不同编辑器/IDE 的基础格式
# 详见 https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Markdown 保留行尾空格（两个尾随空格是 Markdown 的换行语法）
[*.md]
trim_trailing_whitespace = false

# YAML 固定两空格缩进
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Windows 批处理/PowerShell 脚本保持 CRLF
[*.{bat,cmd,ps1}]
end_of_line = crlf
