{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    // 只作为命令行程序发布，不再提供库入口，因此不生成 .d.ts / .d.ts.map
    "declaration": false,
    "sourceMap": true,
    // 把原始源码内联进 sourcemap：npm 包不含 dist 之外的 src/，
    // 不用 inlineSources 的话，用户看堆栈定位不到源码
    "inlineSources": true,
    "isolatedModules": true,
    "types": ["node"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "tests"]
}
